# =============================================================================
# Deadlock AI Platform — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit actual values — use placeholders or safe defaults.

# =============================================================================
# Application
# =============================================================================
APP_ENV=local
APP_NAME= deadlock-ai-platform
APP_VERSION=0.1.0

# =============================================================================
# Frontend (Next.js)
# =============================================================================
# Port for Next.js dev server (runs outside Docker)
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# Backend (FastAPI)
# =============================================================================
# Port for FastAPI dev server (runs outside Docker)
API_PORT=8000
API_V1_PREFIX=/api/v1

# =============================================================================
# Database — PostgreSQL via Docker Compose
# =============================================================================
DATABASE_URL=postgresql+asyncpg://deadlock_ai:deadlock_ai_local@localhost:5432/deadlock_ai
# Synchronous driver for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg2://deadlock_ai:deadlock_ai_local@localhost:5432/deadlock_ai

# =============================================================================
# Redis — via Docker Compose
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Auth — Better Auth (Next.js side)
# =============================================================================
# Discord OAuth (create at https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Auth token secret for FastAPI JWT validation (generate with: openssl rand -hex 32)
AUTH_SECRET=your_auth_secret_here

# =============================================================================
# Object Storage — Cloudflare R2
# =============================================================================
# R2 credentials (create at Cloudflare dashboard)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=deadlock-ai-uploads
R2_PUBLIC_URL=https://your-r2-public-url.com

# =============================================================================
# AI Providers
# =============================================================================
# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# LiteLLM fallback / relay
LITELLM_API_KEY=your_litellm_api_key

# =============================================================================
# Observability
# =============================================================================
# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# GlitchTip (error tracking)
GLITCHTIP_DSN=your_glitchtip_dsn

# =============================================================================
# Email — Resend
# =============================================================================
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@deadlock-ai.com

# =============================================================================
# Telemetry
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000