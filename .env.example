# =============================================================================
# Deadlock AI Platform — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit actual values — use placeholders or safe defaults.

# =============================================================================
# Application
# =============================================================================
APP_ENV=local
APP_NAME=deadlock-ai-platform
APP_VERSION=0.1.0

# =============================================================================
# Frontend (Next.js)
# =============================================================================
# Port for Next.js dev server (runs outside Docker)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# Backend (FastAPI)
# =============================================================================
# Port for FastAPI dev server (runs outside Docker)
API_PORT=8000
API_V1_PREFIX=/api/v1

# =============================================================================
# Database — PostgreSQL via Docker Compose
# =============================================================================
DATABASE_URL=postgresql+asyncpg://deadlock_ai:deadlock_ai_local@localhost:5433/deadlock_ai
# Synchronous driver for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg2://deadlock_ai:deadlock_ai_local@localhost:5433/deadlock_ai

# =============================================================================
# Redis — via Docker Compose
# =============================================================================
REDIS_URL=redis://localhost:6379/0
# Arq uses REDIS_URL for the Phase 2 async worker queue.

# =============================================================================
# Replay Parser Spike (Phase 3)
# =============================================================================
REPLAY_PARSER_COMMAND=
REPLAY_PARSER_TIMEOUT_SECONDS=60
REPLAY_PARSER_MAX_EVENTS=500
LOCAL_REPLAY_SAMPLE_PATH=
ALLOW_LOCAL_REPLAY_PATHS=false

# =============================================================================
# Deadlock API Integration (Phase 2.6)
# =============================================================================
DEADLOCK_API_BASE_URL=https://api.deadlock-api.com
DEADLOCK_ASSETS_API_BASE_URL=https://assets.deadlock-api.com
# Optional API key for higher rate limits
DEADLOCK_API_KEY=
DEADLOCK_API_TIMEOUT_SECONDS=10.0
DEADLOCK_API_CACHE_TTL_MINUTES=60

# =============================================================================
# Auth — Better Auth (Next.js side)
# =============================================================================
# Discord OAuth (create at https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Shared auth secret for Better Auth and FastAPI token validation
# Generate for production with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here
AUTH_SECRET=your_auth_secret_here

# =============================================================================
# Object Storage — Cloudflare R2
# =============================================================================
# R2 credentials (create at Cloudflare dashboard)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=deadlock-ai-uploads
R2_PUBLIC_URL=https://your-r2-public-url.com

# =============================================================================
# AI Providers
# =============================================================================
# Phase 3 structured AI analysis. Keep fake locally unless you want live model calls.
ANALYSIS_MODE=fake
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=45.0
AI_MAX_OUTPUT_TOKENS=2500
AI_TEMPERATURE=0.2
AI_STORE_RAW_PROMPTS=false

# Phase 4 embeddings/RAG. Use mock for local no-cost strategy search.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
RAG_CHUNK_SIZE_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=200
RAG_TOP_K=5
RAG_MAX_SOURCE_CHARS=100000

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# LiteLLM fallback / relay
LITELLM_API_KEY=your_litellm_api_key

# =============================================================================
# Observability
# =============================================================================
# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# GlitchTip (error tracking)
GLITCHTIP_DSN=your_glitchtip_dsn

# =============================================================================
# Email — Resend
# =============================================================================
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@deadlock-ai.com

# =============================================================================
# Telemetry
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000